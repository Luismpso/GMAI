{
  "title": "GMAI — inference service",
  "uid": "gmai-inference",
  "tags": ["gmai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model loaded",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "gmai_model_loaded", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "YES", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [
        { "expr": "sum(rate(gmai_move_requests_total[5m]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 inference latency",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gmai_inference_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Out-of-scope rate",
      "description": "Share of requests for positions the model was never trained on. A high value means the service is being used outside its documented domain.",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gmai_out_of_scope_total[5m])) / clamp_min(sum(rate(gmai_move_requests_total[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error rate",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gmai_move_requests_total{outcome!=\"ok\"}[5m])) / clamp_min(sum(rate(gmai_move_requests_total[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inference latency percentiles",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gmai_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gmai_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gmai_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests by outcome",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(gmai_move_requests_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Q-value of the selected move",
      "description": "Where the agent's confidence sits. A sudden shift usually means a different checkpoint was deployed, or that traffic moved to a different kind of position.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gmai_selected_q_value_bucket[5m])) by (le))",
          "legendFormat": "median Q",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.10, sum(rate(gmai_selected_q_value_bucket[5m])) by (le))",
          "legendFormat": "p10",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(gmai_selected_q_value_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "C"
        }
      ]
    }
  ]
}
